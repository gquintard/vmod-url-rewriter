varnishtest "NULL input and empty rule files"

shell {printf -- '- {type: exact, match: a, output: b}\n' > ${tmpdir}/rules.yaml}
shell {printf '# nothing yet\n' > ${tmpdir}/empty.yaml}

server s1 {} -start

varnish v1 -vcl+backend {
    import redir from "${vmod}";

    sub vcl_init {
        new rules = redir.rules("${tmpdir}/rules.yaml");
        new empty = redir.rules("${tmpdir}/empty.yaml");
    }

    sub vcl_recv {
        return (synth(200));
    }

    sub vcl_synth {
        set resp.http.null = rules.lookup(req.http.missing);
        set resp.http.empty = empty.lookup("a");
        set resp.http.hit = rules.lookup("a");
    }
} -start

logexpect l1 -v v1 -d 1 -g raw {
    expect * 0 VCL_Log {^empty: loaded 0 rules from}
    expect * * VCL_Log {^rules: no rule matched NULL$}
    expect * * VCL_Log {^empty: no rule matched "a"$}
} -start

client c1 {
    txreq
    rxresp
    expect resp.http.null == ""
    expect resp.http.empty == ""
    expect resp.http.hit == "b"
} -run

logexpect l1 -wait
